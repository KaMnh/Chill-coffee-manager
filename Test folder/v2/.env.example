# Chill Manager v2 is frontend-only.
# Point these variables to your self-hosted Supabase API endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3009

# Secrets for Supabase Edge Function: supabase/functions/trigger-pos-sync
# Set these in Supabase, not in the browser/frontend env.
# N8N_POS_SYNC_WEBHOOK_URL=https://n8n.example.com/webhook/chill-pos-sync
# N8N_POS_SYNC_SECRET=replace-with-long-random-secret
# POS_SYNC_COOLDOWN_SECONDS=300
# APP_ALLOWED_ORIGINS=http://localhost:3009,https://chill.example.com
