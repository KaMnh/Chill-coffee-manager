# ==============================================================================
# Chill Manager v2 — Environment configuration
# ==============================================================================
# Copy file này thành `.env` (cùng thư mục với docker-compose.yml), điền giá trị
# thật, rồi `docker compose --env-file .env up -d --build`.
#
# Tương thích Dockge / Portainer Stack / Coolify / Docker CLI.
# ==============================================================================

# ----- 1. Supabase (BẮT BUỘC) -------------------------------------------------
# URL Supabase project (self-hosted hoặc supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.com

# Anon key — public, dùng cho frontend RLS
# Lấy ở: Supabase Studio → Settings → API → "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiI...replace-with-anon-key

# Service role key — SECRET, server-only, BYPASS RLS
# Lấy ở: Supabase Studio → Settings → API → "service_role secret" key
# CẢNH BÁO: KHÔNG commit lên git, KHÔNG paste vào client code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...replace-with-SERVICE-ROLE-key

# ----- 2. App URL + Port (BẮT BUỘC) -------------------------------------------
# Domain công khai của app — dùng cho Settings UI display webhook URL.
# Production: https://chill.your-domain.com
# Dev local:  http://localhost:3009
NEXT_PUBLIC_APP_URL=https://chill.your-domain.com

# Port host máy chủ (container nội bộ vẫn 3000)
# Đổi nếu 3009 đã bị process khác chiếm
APP_PORT=3009

# ----- 3. POS Ingest credentials (BẮT BUỘC) -----------------------------------
# Authenticate với RPC public.ingest_kiotviet_batch.
# Bước setup (chạy 1 lần trên Supabase Studio SQL Editor):
#
#   -- Generate secret (Linux/Mac): openssl rand -base64 32
#   -- Hoặc Windows PowerShell:
#   --   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
#   insert into public.integration_clients (client_id, client_secret_hash, name, is_active)
#   values (
#     'chill-erp',
#     crypt('<paste-generated-secret>', gen_salt('bf')),
#     'Chill ERP Next.js',
#     true
#   );
#
# Sau đó:
INGEST_CLIENT_ID=chill-erp
INGEST_CLIENT_SECRET=<paste-generated-secret-plain-text>

# ----- 4. Cron secret cho polling KiotViet (TÙY CHỌN) -------------------------
# Cho phép system cron / systemd timer gọi /api/kiotviet/sync mà không cần JWT.
# Cron gửi: curl -H "X-Cron-Secret: <CRON_SECRET>" -X POST .../api/kiotviet/sync
# Generate: openssl rand -hex 32
# Để rỗng = disable cron polling (chỉ manual sync qua UI hoạt động).
# Xem chi tiết: docs/kiotviet-polling.md
CRON_SECRET=replace-with-random-32-byte-hex-or-leave-empty

# ==============================================================================
# CHÚ Ý:
#   - 5 var BẮT BUỘC: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#     SUPABASE_SERVICE_ROLE_KEY, INGEST_CLIENT_ID, INGEST_CLIENT_SECRET
#   - 3 var TÙY CHỌN (đã có default): NEXT_PUBLIC_APP_URL, APP_PORT, CRON_SECRET
#   - KiotViet credentials (Client ID, Client Secret, Retailer) KHÔNG nằm trong
#     env — cấu hình qua UI sau khi login: Settings → KiotViet (FNB).
#   - Webhook secret KiotViet cũng cấu hình qua UI cùng chỗ.
# ==============================================================================
